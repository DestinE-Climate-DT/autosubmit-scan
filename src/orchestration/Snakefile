"""
Snakemake Workflow for Error Scanning (File-Centric Architecture)

This workflow implements efficient file-centric error scanning:
1. File discovery (checkpoint) - Find ALL unique files across ALL error patterns
2. File fingerprinting (checkpoint) - Create metadata fingerprint for each unique file
3. Multi-pattern scanning (rule) - Scan each file ONCE for ALL error patterns
4. Result splitting (rule) - Split combined results by error type
5. Result aggregation (rule) - Combine all matches for each error

Key improvement: Each remote file is opened and read EXACTLY ONCE, regardless of
how many error patterns are being checked. This dramatically reduces SSH connections
and I/O operations, preventing timeouts and connection drops.

Usage:
    snakemake --snakefile src/orchestration/Snakefile --configfile config/workflow_config.yaml --cores 4
"""

import json
import sys
from pathlib import Path

# Add src to path for imports
sys.path.insert(0, str(Path.cwd()))

from src.domain.catalog import load_catalog
from src.orchestration.helpers import (
    get_file_hash,
    expand_fsspec_patterns,
    get_fingerprint,
    read_manifest,
    write_manifest,
    get_error_definition,
)
from src.orchestration.scanners import (
    scan_file_for_all_patterns,
)


# Load configuration
configfile: "config/workflow_config.yaml"


# Load error catalog
CATALOG_PATH = config.get("catalog_path", "examples/sample_catalog.yaml")
CATALOG = load_catalog(CATALOG_PATH)

# Extract error IDs
ERROR_IDS = list(CATALOG.errors.keys())

# Output directories
MANIFESTS_DIR = config["output_dirs"]["manifests"]
FINGERPRINTS_DIR = config["output_dirs"]["fingerprints"]
RESULTS_DIR = config["output_dirs"]["results"]
AGGREGATED_DIR = config["output_dirs"]["aggregated"]


# ============================================================================
# TARGET RULE: Generate all aggregated results
# ============================================================================

rule all:
    input:
        expand(
            f"{AGGREGATED_DIR}/{{error_id}}_all_matches.json",
            error_id=ERROR_IDS
        )


# ============================================================================
# CHECKPOINT: Discover All Unique Files
# Finds all unique files across ALL error patterns (deduplicated)
# ============================================================================

checkpoint discover_all_unique_files:
    output:
        manifest=f"{MANIFESTS_DIR}/all_unique_files.txt"
    run:
        all_files = set()

        # Collect files from all error definitions
        for error_id in ERROR_IDS:
            error_def = get_error_definition(CATALOG, error_id)
            discovered_files = expand_fsspec_patterns(error_def.files)
            all_files.update(discovered_files)

        # Convert to sorted list for deterministic output
        unique_files = sorted(all_files)

        # Write manifest
        write_manifest(output.manifest, unique_files)

        print(f"Discovered {len(unique_files)} unique files across all {len(ERROR_IDS)} error patterns")


# ============================================================================
# CHECKPOINT: File Fingerprinting
# Creates fingerprints for caching and change detection (ONE per unique file)
# ============================================================================

checkpoint fingerprint_file:
    input:
        manifest=f"{MANIFESTS_DIR}/all_unique_files.txt"
    output:
        fingerprint=f"{FINGERPRINTS_DIR}/{{file_hash}}.json"
    run:
        # Read the manifest to get file URIs
        file_uris = read_manifest(input.manifest)

        # Find the URI that matches this file hash
        target_uri = None
        for uri in file_uris:
            if get_file_hash(uri) == wildcards.file_hash:
                target_uri = uri
                break

        if target_uri is None:
            raise ValueError(f"No file found with hash {wildcards.file_hash}")

        # Get fingerprint
        fingerprint = get_fingerprint(target_uri)

        # Write fingerprint JSON
        Path(output.fingerprint).parent.mkdir(parents=True, exist_ok=True)
        with open(output.fingerprint, 'w') as f:
            json.dump(fingerprint, f, indent=2)


# ============================================================================
# RULE: Scan File for All Patterns (Multi-Pattern Scanning)
# Opens file ONCE and scans for ALL error patterns in memory
# ============================================================================

rule scan_file_all_patterns:
    input:
        fingerprint=f"{FINGERPRINTS_DIR}/{{file_hash}}.json"
    output:
        results=f"{RESULTS_DIR}/combined/{{file_hash}}_all_errors.json"
    run:
        # Load fingerprint to get file URI
        with open(input.fingerprint, 'r') as f:
            fingerprint = json.load(f)

        file_uri = fingerprint["uri"]

        # Scan file for ALL error patterns in one pass
        all_matches = scan_file_for_all_patterns(file_uri, CATALOG)

        # Convert ErrorMatch objects to JSON
        results_by_error = {}
        for error_id, matches in all_matches.items():
            results_by_error[error_id] = [match.model_dump(mode='json') for match in matches]

        # Write combined results
        Path(output.results).parent.mkdir(parents=True, exist_ok=True)
        with open(output.results, 'w') as f:
            json.dump(results_by_error, f, indent=2)

        total_matches = sum(len(matches) for matches in all_matches.values())
        print(f"Scanned {file_uri}: found {total_matches} total matches across {len(all_matches)} error types")


# ============================================================================
# RULE: Split Results by Error Type
# Extracts results for a specific error from the combined results
# ============================================================================

rule split_results_by_error:
    input:
        combined=f"{RESULTS_DIR}/combined/{{file_hash}}_all_errors.json"
    output:
        split=f"{RESULTS_DIR}/by_error/{{error_id}}/{{file_hash}}.json"
    run:
        # Load combined results
        with open(input.combined, 'r') as f:
            all_results = json.load(f)

        # Extract matches for this specific error
        error_matches = all_results.get(wildcards.error_id, [])

        # Write split results
        Path(output.split).parent.mkdir(parents=True, exist_ok=True)
        with open(output.split, 'w') as f:
            json.dump(error_matches, f, indent=2)


# ============================================================================
# RULE: Aggregate Results by Error
# Combines all file results for each error type
# ============================================================================

def get_split_files_for_error(wildcards):
    """Get all split result files for a specific error after file discovery."""
    # Wait for file discovery checkpoint
    checkpoints.discover_all_unique_files.get()

    # Read the manifest
    manifest_path = f"{MANIFESTS_DIR}/all_unique_files.txt"
    file_uris = read_manifest(manifest_path)

    # Get file hashes
    file_hashes = [get_file_hash(uri) for uri in file_uris]

    # Expand to split result files for this error
    return expand(
        f"{RESULTS_DIR}/by_error/{{error_id}}/{{file_hash}}.json",
        error_id=wildcards.error_id,
        file_hash=file_hashes
    )


rule aggregate_by_error:
    input:
        split_files=get_split_files_for_error
    output:
        aggregated=f"{AGGREGATED_DIR}/{{error_id}}_all_matches.json"
    run:
        all_matches = []

        # Combine all matches from all files
        for result_file in input.split_files:
            with open(result_file, 'r') as f:
                file_matches = json.load(f)
            all_matches.extend(file_matches)

        # Write aggregated results
        Path(output.aggregated).parent.mkdir(parents=True, exist_ok=True)
        with open(output.aggregated, 'w') as f:
            json.dump(all_matches, f, indent=2)

        print(f"Aggregated {len(all_matches)} total matches for error '{wildcards.error_id}'")
