{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destine-climate-dt.github.io/autosubmit-scan/schema/ErrorReport.json",
  "title": "ErrorReport",
  "description": "A complete error scan report containing matches, definitions, and summary statistics",
  "type": "object",
  "properties": {
    "@context": {
      "type": "object",
      "description": "JSON-LD context defining vocabularies and namespaces"
    },
    "@type": {
      "type": "string",
      "const": "ErrorReport",
      "description": "JSON-LD type identifier"
    },
    "@id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Unique identifier for this report (UUID URN)"
    },
    "version": {
      "type": "string",
      "description": "Report format version"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the report was generated"
    },
    "author": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "const": "Person"
        },
        "name": {
          "type": "string",
          "description": "Name of the person who ran the scan"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the person who ran the scan"
        }
      },
      "required": ["@type", "name", "email"],
      "additionalProperties": false,
      "description": "Person who generated this report"
    },
    "catalog": {
      "type": "object",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri",
          "description": "URI of the error catalog used for this scan"
        },
        "@type": {
          "type": "string",
          "const": "ErrorCatalog"
        },
        "version": {
          "type": "string",
          "description": "Version of the catalog"
        },
        "dateRetrieved": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the catalog was retrieved for this scan"
        }
      },
      "required": ["@id", "@type", "version", "dateRetrieved"],
      "additionalProperties": false,
      "description": "Reference to the error catalog used for this scan"
    },
    "summary": {
      "$ref": "Summary.json",
      "description": "Aggregate statistics for the scan"
    },
    "defines": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "ErrorDefinition.json"},
          {
            "properties": {
              "@type": {
                "type": "string",
                "const": "ErrorDefinition"
              },
              "@id": {
                "type": "string",
                "pattern": "^#",
                "description": "Local identifier for cross-referencing (e.g., '#slurm_oom')"
              }
            },
            "required": ["@type", "@id"]
          }
        ]
      },
      "description": "Embedded error definitions for offline use (snapshot from catalog)"
    },
    "hasPart": {
      "type": "array",
      "items": {
        "$ref": "ErrorMatch.json"
      },
      "description": "List of error matches found during the scan"
    }
  },
  "required": [
    "@context",
    "@type",
    "@id",
    "version",
    "dateCreated",
    "author",
    "catalog",
    "summary",
    "defines",
    "hasPart"
  ],
  "additionalProperties": false
}
