<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error Scan Report</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { padding: 20px; }
        .error-match { margin-bottom: 10px; }
        .error-type { margin-top: 30px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Error Scan Report</h1>
        <p class="text-muted">Generated: {{ date }}</p>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="card-title">Summary</h2>
                <ul>
                    <li><strong>Total Matches:</strong> {{ summary.totalMatches }}</li>
                    <li><strong>Error Types:</strong> {{ summary.errorTypes }}</li>
                    <li><strong>Files Scanned:</strong> {{ summary.filesScanned }}</li>
                </ul>
            </div>
        </div>

        <h2>Errors by Type</h2>

        {% for error_type, matches in errors_by_type.items() %}
        <div class="error-type">
            <h3>{{ error_type }} <span class="badge bg-primary">{{ matches|length }}</span></h3>

            {% for match in matches %}
            <div class="error-match alert alert-warning">
                <strong>{{ match.file }}:{{ match.line }}</strong> - {{ match.text }}
            </div>
            {% endfor %}
        </div>
        {% endfor %}

        <footer class="mt-5 text-muted">
            <hr>
            <p>Generated by autosubmit-scan</p>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
